/* ====== 全局背景 ====== */
body {
    margin: 0;
    font-family: "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    background: linear-gradient(135deg, #2b5876, #4e4376);
    /* 与 page-container 一致 */
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 2rem;
    color: #f5f5f5;
    /* 默认文字颜色改成浅色，避免和深色背景冲突 */
}

/* 页面整体背景（保持一致，宽度自适应） */
.page-container {
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 2rem;
    background: linear-gradient(135deg, #2b5876, #4e4376);
    color: #f5f5f5;
}

/* 标题样式 */
.page-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    text-align: center;
    color: #ffffff;
}

/* ====== 卡片（说明区块） ====== */
.dashboard-card,
.info-card {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    width: 100%;
    max-width: 900px;
    /* 限制最大宽度，避免太宽 */
    margin: 0 auto;
    backdrop-filter: blur(8px);
}

.card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0, 255, 150, 0.4);
    border-color: rgba(0, 255, 150, 0.5);
}

/* ====== 输入框/按钮统一风格 ====== */
input,
select,
textarea {
    width: 100%;
    padding: 0.6rem 0.8rem;
    border-radius: 0.6rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 1rem;
    outline: none;
    margin-bottom: 1rem;
}

input:focus,
select:focus,
textarea:focus {
    border-color: rgba(0, 255, 150, 0.8);
    box-shadow: 0 0 6px rgba(0, 255, 150, 0.6);
}

/* 按钮 */
button,
.controls button,
.sort-buttons button,.tool-btn-outline {
    padding: 10px 18px;
    border: none;
    border-radius: 12px;
    /* 与 tool-btn 一致 */
    background: linear-gradient(135deg, #3a8dde, #0052cc);
    color: white;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.3s ease;
}

button:hover {
    transform: translateY(-2px);
    background: linear-gradient(135deg, #4ea0f5, #0066ff);
}

button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

/* 成功按钮（复制结果用） */
button.btn-success {
    background: linear-gradient(135deg, #28a745, #218838);
}

button.btn-success:hover {
    background: linear-gradient(135deg, #34d058, #1e7e34);
}

/* 工具列表网格 */
.tools-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    /* 强制双列 */
    gap: 1.2rem;
    width: 100%;
    max-width: 900px;
    /* 和卡片一致，避免太宽 */
    margin-top: 1.5rem;
}

/* 工具按钮 */
.tool-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.9rem 1.2rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.1);
    color: #1e88e5;
    font-weight: 600;
    transition: all 0.25s ease;
    text-align: center;
    text-decoration: none;
}

/* 鼠标悬停与焦点动画 */
.tool-btn:hover,
.tool-btn:focus {
    background: rgba(255, 255, 255, 0.18);
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);
}

/* 按钮里的图标 */
.tool-btn i {
    font-size: 1.3rem;
    color: #42a5f5;
    /* 更亮的蓝色，提升层次感 */
}

/* 平板及桌面端 → 双列 */
@media (min-width: 768px) {
    .tools-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

/* Chrome, Safari, Edge, Opera 隐藏 number input 的箭头 */
input[type="number"]::-webkit-outer-spin-button,
input[type="number"]::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
}

/* Firefox 隐藏 number input 的箭头 */
input[type="number"] {
    -moz-appearance: textfield;
}

/* 统一复选框与文字对齐 */
.form-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.25rem 0;
    color: #fff;
    /* 保证文字清晰 */
    font-size: 1rem;
}

/* 美化复选框 */
.form-check input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: #007bff;
    /* 现代蓝色 */
    cursor: pointer;
}